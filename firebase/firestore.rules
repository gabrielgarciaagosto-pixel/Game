rules_version = '2';
// Dungeon Master reads are limited to this Firebase Auth email.
// The public game cannot read these docs. Already published for ossuarian-first-urn.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'gabrielgarciaagosto@gmail.com';
    }

    function isAnonymousPlayer() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function payloadOk(installId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'owner',
          'installId',
          'versionName',
          'versionCode',
          'platform',
          'lastSeen',
          'sessionStartedAt',
          'sessionMs',
          'recentSessionMs'
        ])
        && data.owner == request.auth.uid
        && data.installId == installId
        && data.installId is string
        && data.installId.size() >= 16
        && data.installId.size() <= 80
        && data.versionName is string
        && data.versionName.size() > 0
        && data.versionName.size() < 40
        && data.versionCode is int
        && data.versionCode > 0
        && data.versionCode < 1000000
        && data.platform in ['web', 'android', 'ios']
        && data.lastSeen is int
        && data.lastSeen > request.time.toMillis() - 10 * 60 * 1000
        && data.lastSeen < request.time.toMillis() + 2 * 60 * 1000
        && data.sessionStartedAt is int
        && data.sessionMs is int
        && data.sessionMs >= 0
        && data.sessionMs < 48 * 60 * 60 * 1000
        && data.recentSessionMs is list
        && data.recentSessionMs.size() <= 8;
    }

    match /presence/{installId} {
      allow read: if isMaster();
      allow create: if isAnonymousPlayer() && payloadOk(installId);
      allow update: if isAnonymousPlayer()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && payloadOk(installId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
